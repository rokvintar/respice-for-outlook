<?xml version="1.0" encoding="UTF-8"?>
<!-- Template. Generate manifest.xml with: node scripts/build-manifest.mjs <base-url> -->
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">
  <Id>247814bb-cadc-420c-81a7-e9516e56fecf</Id>
  <Version>{{VERSION}}.0</Version>
  <ProviderName>Respice for Outlook</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Respice for Outlook"/>
  <Description DefaultValue="Version {{VERSION}}. Warns before sending to external recipients, mailing lists, too many recipients, or replying to more than the sender."/>
  <IconUrl DefaultValue="{{BASE_URL}}/assets/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="{{BASE_URL}}/assets/icon-128.png"/>
  <SupportUrl DefaultValue="{{BASE_URL}}/"/>
  <AppDomains>
    <AppDomain>{{ORIGIN}}</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="{{BASE_URL}}/src/taskpane.html"/>
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <!-- 1.5 so Outlook mobile (which reports Mailbox 1.5) loads the add-in. Desktop clients still need
           1.10/1.11/1.12 for the compose, recipients and send events and ignore events they don't support. -->
      <Requirements>
        <bt:Sets DefaultMinVersion="1.5">
          <bt:Set Name="Mailbox"/>
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <Runtimes>
            <!-- Browser runtime: Outlook on the web, on Mac, new Outlook on Windows. -->
            <Runtime resid="WebViewRuntime.Url">
              <!-- JavaScript-only runtime: classic Outlook on Windows. -->
              <Override type="javascript" resid="JSRuntime.Url"/>
            </Runtime>
          </Runtimes>
          <DesktopFormFactor>
            <FunctionFile resid="Commands.Url"/>
            <ExtensionPoint xsi:type="MessageReadCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="respiceReadGroup">
                  <Label resid="GroupLabel"/>
                  <Control xsi:type="Button" id="respiceReadSettingsButton">
                    <Label resid="SettingsButton.Label"/>
                    <Supertip>
                      <Title resid="SettingsButton.Label"/>
                      <Description resid="SettingsButton.Tooltip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16x16"/>
                      <bt:Image size="32" resid="Icon.32x32"/>
                      <bt:Image size="80" resid="Icon.80x80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="Taskpane.Url"/>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
            <ExtensionPoint xsi:type="MessageComposeCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="respiceComposeGroup">
                  <Label resid="GroupLabel"/>
                  <Control xsi:type="Button" id="respiceComposeSettingsButton">
                    <Label resid="SettingsButton.Label"/>
                    <Supertip>
                      <Title resid="SettingsButton.Label"/>
                      <Description resid="SettingsButton.Tooltip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16x16"/>
                      <bt:Image size="32" resid="Icon.32x32"/>
                      <bt:Image size="80" resid="Icon.80x80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="Taskpane.Url"/>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
            <ExtensionPoint xsi:type="LaunchEvent">
              <LaunchEvents>
                <!-- PromptUser: the dialog always offers "Send Anyway"; if the add-in fails to load, mail is not blocked. -->
                <LaunchEvent Type="OnMessageSend" FunctionName="onMessageSendHandler" SendMode="PromptUser"/>
                <!-- Live warning bar while composing (Mailbox 1.10 / 1.11). -->
                <LaunchEvent Type="OnNewMessageCompose" FunctionName="onComposeChangedHandler"/>
                <LaunchEvent Type="OnMessageRecipientsChanged" FunctionName="onComposeChangedHandler"/>
              </LaunchEvents>
              <SourceLocation resid="WebViewRuntime.Url"/>
            </ExtensionPoint>
          </DesktopFormFactor>
          <!-- Outlook on iOS / Android: only the warning bar. Mobile has no Smart Alerts (no check at Send). -->
          <MobileFormFactor>
            <ExtensionPoint xsi:type="LaunchEvent">
              <LaunchEvents>
                <LaunchEvent Type="OnNewMessageCompose" FunctionName="onComposeChangedHandler"/>
                <LaunchEvent Type="OnMessageRecipientsChanged" FunctionName="onComposeChangedHandler"/>
              </LaunchEvents>
              <SourceLocation resid="WebViewRuntime.Url"/>
            </ExtensionPoint>
          </MobileFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
          <bt:Image id="Icon.16x16" DefaultValue="{{BASE_URL}}/assets/icon-16.png"/>
          <bt:Image id="Icon.32x32" DefaultValue="{{BASE_URL}}/assets/icon-32.png"/>
          <bt:Image id="Icon.80x80" DefaultValue="{{BASE_URL}}/assets/icon-80.png"/>
        </bt:Images>
        <bt:Urls>
          <bt:Url id="Commands.Url" DefaultValue="{{BASE_URL}}/src/commands.html"/>
          <bt:Url id="Taskpane.Url" DefaultValue="{{BASE_URL}}/src/taskpane.html"/>
          <bt:Url id="WebViewRuntime.Url" DefaultValue="{{BASE_URL}}/src/commands.html"/>
          <bt:Url id="JSRuntime.Url" DefaultValue="{{BASE_URL}}/src/launchevent.js"/>
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="GroupLabel" DefaultValue="Respice"/>
          <bt:String id="SettingsButton.Label" DefaultValue="Respice settings"/>
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="SettingsButton.Tooltip" DefaultValue="Configure the recipient checks (v{{VERSION}})."/>
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
